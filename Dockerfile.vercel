FROM ruby:2.3.8

WORKDIR /app

# Ruby 2.3 uses Debian Jessie, whose package mirrors are archived.
RUN sed -i 's|deb.debian.org/debian|archive.debian.org/debian|g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list \
 && sed -i '/jessie-updates/d' /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev nodejs ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN gem install bundler -v 1.17.3 --no-document

COPY Gemfile Gemfile.lock ./
RUN bundle _1.17.3_ install --without development test

COPY . .

RUN chmod +x bin/vercel-start

ENV RAILS_ENV=production
ENV RACK_ENV=production
ENV PORT=80

CMD ["./bin/vercel-start"]
